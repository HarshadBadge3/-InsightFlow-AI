# InsightFlow AI — Environment Configuration Example
# Copy this file to .env and configure optional variables as needed.

# Application Environment (development, production)
ENVIRONMENT=production

# Server Port (Default: 8501)
STREAMLIT_SERVER_PORT=8501

# Optional AI / External Model Integration
# InsightFlow AI operates fully deterministically without requiring an API key.
# If integrating an optional external LLM service, place credentials here:
# LLM_API_KEY=your_api_key_here
